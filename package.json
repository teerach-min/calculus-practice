{
  "name": "calculus-practice",
  "version": "1.0.0",
  "private": true,
  "description": "ฝึกแคลคูลัสเบื้องต้น — 18 หัวข้อ สุ่มโจทย์ไม่จำกัด พร้อมเฉลยทีละขั้น",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:answers": "esbuild scripts/check-answers.ts --bundle --platform=node --format=esm --outfile=.tmp-test.mjs --log-level=error && node .tmp-test.mjs",
    "test:render": "node scripts/verify.mjs",
    "test:reference": "node scripts/verify-reference.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  }
}
