# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
# ค่าที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูกฝังลงไฟล์ static ตอน build
# (ค่าเหล่านี้เปิดเผยได้ ไม่ใช่ความลับ — ความปลอดภัยอยู่ที่ Authorized origins
#  ของ OAuth client และการตรวจ token ฝั่ง Apps Script)

# OAuth 2.0 Client ID จาก Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL ของ Apps Script Web App (ลงท้ายด้วย /exec)
NEXT_PUBLIC_SHEET_ENDPOINT=

# ตั้งเฉพาะตอน deploy ลง GitHub Pages แบบ project site
# (บน GitHub Actions ตั้งให้แล้วใน .github/workflows/deploy.yml)
# NEXT_PUBLIC_BASE_PATH=/calculus-practice
